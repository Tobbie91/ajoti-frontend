{
    "name": "ajoti-monorepo",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build:admin": "pnpm --filter ajoti-admin build",
        "build:super-admin": "pnpm --filter ajoti-super-admin build",
        "test:e2e": "playwright test",
        "test:e2e:report": "playwright show-report",
        "lint": "pnpm --recursive --if-present lint",
        "security:cve": "pnpm audit --audit-level=high",
        "security:cve:json": "pnpm audit --json",
        "security:sast": "semgrep scan --config .semgrep.yml --error",
        "security:sast:json": "semgrep scan --config .semgrep.yml --json --output security-semgrep.json",
        "security:secrets": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
        "security:secrets:json": "gitleaks git . --config .gitleaks.toml --redact --report-format json --report-path security-gitleaks.json --no-banner",
        "security:all": "pnpm security:cve && pnpm security:sast && pnpm security:secrets"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1"
    }
}
